# Template only — provisional local Compose staging validation.
# Do NOT use this file as-is for live traffic.
# Copy to .env.staging (gitignored) and replace placeholders with real values.
# Never commit .env.staging or real secrets.

APP_ENV=staging
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=onlybook_faq_bge_m3_v1
PREFER_BGE=true
RETRIEVAL_LANGUAGE_FILTER=true
EMBEDDING_MODEL=BAAI/bge-m3

MOCK_LLM=false
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=__REQUIRED__

# Omit this variable entirely when Qdrant authentication is not required.
# QDRANT_API_KEY=__REQUIRED_IF_AUTH_ENABLED__

# Host port exposed by the provisional Compose staging stack.
STAGING_API_PORT=18000
