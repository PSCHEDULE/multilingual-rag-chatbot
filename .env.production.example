# Template only — repository production packaging example.
# Copy to a private .env.production (gitignored) and replace placeholders.
# Never commit real secrets. This file is not an approval to cut over traffic.

# Required production labels
APP_ENV=production
MOCK_LLM=false

# Pre-built runtime image tag (platform supplies the real registry path)
APP_IMAGE=ghcr.io/example/multilingual-rag-chatbot:REPLACE_WITH_RELEASE_TAG

# Host port for the API service
PRODUCTION_API_PORT=8000

# Retrieval (must stay paired)
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=onlybook_faq_bge_m3_v1
PREFER_BGE=true
RETRIEVAL_LANGUAGE_FILTER=true
EMBEDDING_MODEL=BAAI/bge-m3

# LLM — provider secret required when MOCK_LLM=false
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=__REQUIRED__

# Optional: only when Qdrant authentication is enabled
# QDRANT_API_KEY=__REQUIRED_IF_AUTH_ENABLED__

# Production CORS — explicit origins required (wildcard * is rejected at settings init).
# Explicit origins enable allow_credentials for cookie-capable browser embeds.
CORS_ORIGINS=https://app.example.com

LOG_LEVEL=INFO
