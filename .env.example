# Application
APP_ENV=development
LOG_LEVEL=INFO
# Dev may use * (credentials are forced off when origins are wildcard).
# Production must list explicit origins (see .env.production.example).
CORS_ORIGINS=*

# LLM — single model strategy: OpenAI gpt-4o-mini (M2 contextualize, M4 graph, M7 RAGAS)
# Chosen for cost–quality balance on multilingual support workloads.
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=
# Optional alias:
# LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1024
# Set true for offline/tests
MOCK_LLM=false

# Qdrant
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
# Active retrieval collection (must stay consistent with PREFER_BGE — see below)
QDRANT_COLLECTION=support_faq
# Rollback (hash baseline, never delete):
#   QDRANT_COLLECTION=onlybook_faq
#   PREFER_BGE=false
# Soft cutover (BGE-M3 + M8-A atomic FAQ index):
#   QDRANT_COLLECTION=onlybook_faq_bge_m3_v1
#   PREFER_BGE=true
# Requires: uv sync --group bge

# Embeddings / reranker
EMBEDDING_MODEL=BAAI/bge-m3
# Dense path: false = OfflineHashEmbedder (dim 384); true = BGE-M3 (dim 1024)
PREFER_BGE=false
# When true, hybrid search filters by detected query language
RETRIEVAL_LANGUAGE_FILTER=true
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RETRIEVAL_TOP_N=40
RETRIEVAL_TOP_K=6
# Post-rerank pruning for LLM context + sources event (max 3 docs)
# Top-1 always kept; Top-2/3 need score >= abs AND score >= top1 * relative
PRUNE_ABSOLUTE_THRESHOLD=0.05
PRUNE_RELATIVE_THRESHOLD=0.05

# Ingestion
CONTEXTUALIZE=true
CHUNK_BREAKPOINT_PERCENTILE=95

# Langfuse (optional — leave empty to disable)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=

# Defaults
DEFAULT_LANGUAGE=en
SESSION_HISTORY_MAX_TURNS=20
